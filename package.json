{
  "name": "opiniated-mystmd-book-template",
  "version": "1.0.0",
  "private": true,
  "description": "An opinionated, PWA-ready MyST Markdown book template.",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "npm": ">=10 <11"
  },
  "scripts": {
    "start": "myst start",
    "build": "myst build --html && node scripts/setup-pwa.mjs",
    "verify": "node scripts/verify-book.mjs",
    "check": "npm run verify && myst build --html --strict --check-links"
  },
  "devDependencies": {
    "mystmd": "1.10.1",
    "sharp": "0.35.4",
    "yaml": "2.9.0"
  }
}
